    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.12.0",
    "jsdoc": "^4.0.4",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/client-sqs": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@google/genai": "^2.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "debug": "^4.3.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "http": "^0.0.1-security",
    "joi": "^17.13.3",
