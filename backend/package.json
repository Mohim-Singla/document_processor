{
  "name": "node_service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prestart": "npm run db:create && npm run db:migrate && npm run db:seed",
    "start": "DEBUG=app:request node src/app.js",
    "dev": "DEBUG=app:request nodemon src/app.js",
    "worker": "DEBUG=app:request node src/worker.js",
    "worker:dev": "DEBUG=app:request nodemon --exec \"node src/worker.js\" src/worker.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:fix": "eslint --fix '**/*.{js,cjs}'",
    "db:create": "npx sequelize db:create",
    "db:migrate": "npx sequelize db:migrate",
    "db:seed": "npx sequelize db:seed:all",
    "db:undo-migrate": "npx sequelize db:migrate:undo",
    "db:undo-seed": "npx sequelize db:seed:undo:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
