    "mammoth": "^1.12.3",
    "mongoose": "^8.8.1",
    "multer": "^2.4.0",
    "mysql2": "^3.11.4",
    "pdf-parse": "^1.1.1",
    "pdf2json": "^4.1.0",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "sqs-consumer": "^15.0.3",
